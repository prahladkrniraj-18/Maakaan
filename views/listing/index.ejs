<% layout("/layouts/boilerplate")-%>
<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    margin-bottom: 1rem;
    margin-top: 1rem;
    background-color: white;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.8rem;
  }
  .tax-toggle {
    display: flex;
    align-items: center;
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 0.5rem;
    /* margin-left: 1rem; */
  }
  .tax-info {
    display: none;
  }
</style>
<body>
  <!-- <a href="listing/new"><button>Create New Listing</button></a> -->

  <a href="/listing/category"> </a>
  <div id="filters">
    <div class="filter">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-archway"></i>
      <p>Iconic Cites</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-mountain-sun"></i>
      <p>Mountains</p>
    </div>
    <div class="filter">
      <i class="fa-brands fa-fort-awesome"></i>
      <p>Castles</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-swimmer"></i>
      <p>Amazing Pools</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-tent"></i>
      <p>Camping</p>
    </div>
    <div class="collapse navbar-collapse"></div>
    <div class="filter">
      <i class="fa-solid fa-tractor"></i>
      <p>Farms</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-snowflake"></i>
      <p>Arctic</p>
    </div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch tax-toggle-switch">
        <input
          class="form-check-input"
          type="checkbox"
          role="switch"
          id="flexSwitchCheckDefault"
        />
        <label class="form-check-label" for="flexSwitchCheckDefault"
          >Display total after taxes</label
        >
      </div>
    </div>
  </div>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allListings){ %>

    <a href="/listing/<%= listing._id  %>" class="listing-links">
      <div class="card card-listing col" style="width: 20rem">
        <img
          src="<%= listing.image.url  %>"
          class="card-img-top"
          alt="<% listing.title %>"
          style="height: 15rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <b><p class="card-text"><%= listing.title %></p></b>
          <p class="price">
            &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
            <i class="tax-info">&nbsp;+18%GST</i>
          </p>
        </div>
      </div>
    </a>

    <% } %>
  </div>
</body>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfos = document.getElementsByClassName("tax-info");
    for (let taxInfo of taxInfos) {
      // console.log(taxInfo);
      if (taxInfo.style.display != "inline") {
        taxInfo.style.display = "inline";
      } else {
        taxInfo.style.display = "none";
      }
    }
  });
  let filter = document.getElementById("filters");
  filter.addEventListener("click", () => {
    console.log();
  });
</script>
